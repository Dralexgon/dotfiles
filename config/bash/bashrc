pre-commit() {
    # find -iname "*.[ch]" -exec clang-format -i {} \; -exec sed -i -e '$a\' {} \;
    find \( -iname "*.c" -o -iname "*.h" -o -iname "*.cc" -o -iname "*.hh" -o -iname "*.hxx" \) -exec clang-format -i {} \; -exec sed -i -e '$a\' {} \;
}

ac() {
    git add .
    git commit -m "$1"
    pre-commit
    git add .
    git commit -m "clean: [AUTOMATIC] (command alias with clang-format)"
}

acp() {
    git add .
    git commit -m "$1"
    pre-commit
    git add .
    git commit -m "clean: [AUTOMATIC] (command alias with clang-format)"
    git push
}

acpt() {
    pre-commit
    git add .
    git commit -m "clean: [AUTOMATIC] (command alias with clang-format) tag: $1"
    git tag -a "$1" -m "$1"
    git push --follow-tags
}

swapf() {
    if [ "$#" -ne 2 ]; then
        echo "Usage: swapf file1 file2"
        return 1
    fi

    file1="$1"
    file2="$2"
    tempfile=$(mktemp)

    if [ ! -e "$file1" ] || [ ! -e "$file2" ]; then
        echo "Error: Both files must exist."
        return 1
    fi

    mv "$file1" "$tempfile" && mv "$file2" "$file1" && mv "$tempfile" "$file2"

    if [ $? -eq 0 ]; then
        echo "Swapped: $file1 <-> $file2"
    else
        echo "Error: File swapping failed."
    fi
}

de() {
    # Move to trash
    TRASH_DIR="$HOME/.local/share/Trash/files"
    # Check if file exist
    if [ -e "$1" ]; then
        # Check if trash directory exist
        if [ ! -d "$TRASH_DIR" ]; then
            TRASH_DIR="$HOME/.Trash"
        fi
        if [ -d "$1" ]; then
            mv -r "$1" "$TRASH_DIR"
        else
            mv "$1" "$TRASH_DIR"
        fi
        echo "Moved to trash: $1"
    else
        echo "Error: File does not exist."
    fi
}

